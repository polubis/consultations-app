---
import { CommentsSection } from "./comments-section";

// src/features/mentoring/why-section.astro
---

<section
  class="page-section fluid"
  aria-labelledby="why-section-title"
>
  <div class="max-w-4xl mx-auto">
    <h2
      id="why-section-title"
      class="text-[31px] font-500 mb-[32px]"
    >
      Dlaczego warto?
    </h2>

    <div class="grid sbl:grid-cols-2 gap-8 sbl:gap-10">
      <div class="flex items-start gap-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-500 shrink-0 mt-1"
          aria-hidden="true"
        >
          <polygon
            points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
          >
          </polygon>
        </svg>
        <div>
          <p class="text-foreground font-500 text-regular">
            Średnia ocena <span class="text-primary-500">9.4/10</span> na podstawie 100 opinii
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-500 shrink-0 mt-1"
          aria-hidden="true"
        >
          <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
          <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
          <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
          <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
        </svg>
        <div>
          <p class="text-foreground font-500 text-regular">
            82% osób awansowało w ciągu 6 miesięcy po mentoringu
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-500 shrink-0 mt-1"
          aria-hidden="true"
        >
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
          <path d="M9 18h6"></path>
          <path d="M10 22h4"></path>
        </svg>
        <div>
          <p class="text-foreground font-500 text-regular">
            90 osób podkreśla skuteczność mentoringu
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-500 shrink-0 mt-1"
          aria-hidden="true"
        >
          <path d="M7 10v12"></path>
          <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"></path>
        </svg>
        <div>
          <p class="text-foreground font-500 text-regular">
            80 osób ceni spersonalizowane, holistyczne podejście
          </p>
        </div>
      </div>
    </div>

    <CommentsSection client:load />
  </div>
</section>

