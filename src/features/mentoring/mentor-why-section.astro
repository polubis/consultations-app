---
import { CommentsSection } from "./comments-section";

// src/features/mentoring/why-section.astro
---

<section class="page-section fluid" aria-labelledby="why-section-title">
  <div class="max-w-4xl mx-auto dsp:max-w-none dsp:grid dsp:grid-cols-2 dsp:gap-[64px]">
    <!-- Left Column: Dlaczego warto? -->
    <div>
      <h2 id="why-section-title" class="text-h2 font-500 mb-[32px]">
        Dlaczego warto?
