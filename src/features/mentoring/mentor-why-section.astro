            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary-500"
            aria-hidden="true"
          >
            <defs>
              <clipPath id="clip0_974_5434">
