---
import { MarkdownRenderer } from "./markdown-renderer";
import { CourseNavigation } from "./course-navigation";
import { processMarkdown } from "./markdown-processor";
import {
  validateTimeline,
  validateGallery,
  validateMindmap,
} from "./markdown-schemas";

interface Props {
  markdownContent: string;
  frontmatter: {
    timeline?: Array<{
      month: number;
      roman: string;
      modules: string[];
      title?: string;
      description?: string;
    }>;
    gallery?: Array<{ src: string; alt: string }>;
    mindmap?: {
      edges: Array<{
        id: string;
        source: string;
        target: string;
        type: string;
      }>;
      nodes: Array<{
        id: string;
        type: string;
        position: { x: number; y: number };
        data: {
          content: string;
          description: string | null;
          name: string;
          path: string;
        };
      }>;
      orientation: string;
    };
  };
}

const { markdownContent, frontmatter } = Astro.props;

const validatedTimeline = frontmatter.timeline
  ? validateTimeline(frontmatter.timeline)
  : undefined;

const validatedGallery = frontmatter.gallery
  ? validateGallery(frontmatter.gallery)
  : undefined;

const validatedMindmap = frontmatter.mindmap
  ? validateMindmap(frontmatter.mindmap)
  : undefined;

const {
  content: processedContent,
  navigationItems,
  headingIds,
} = processMarkdown(markdownContent);
---

<section class="fluid py-[64px] tbt:py-[96px] dsp:py-[120px]">
  <div class="dsp:grid dsp:grid-cols-[245px_1fr] dsp:gap-[20px]">
    <CourseNavigation items={navigationItems} client:load />

    <!-- Main Content -->
    <div class="w-full">
      <MarkdownRenderer
      content={processedContent}
      timeline={validatedTimeline || undefined}
      gallery={validatedGallery || undefined}
      mindmap={validatedMindmap || undefined}
      headingIds={headingIds}
      client:load
    />
    </div>
  </div>
</section>

