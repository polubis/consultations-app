---
import { MarkdownRenderer } from "./markdown-renderer";
import { CourseNavigation } from "./course-navigation";

interface Props {
  markdownContent: string;
  frontmatter: {
    timeline?: Array<{ month: number; roman: string; modules: string[] }>;
    gallery?: Array<{ src: string; alt: string }>;
  };
}

const { markdownContent, frontmatter } = Astro.props;

// Extract navigation items from markdown headings
const navigationItems: Array<{ id: string; label: string }> = [];
const headingRegex = /^##\s+(.+)$/gm;
const matches = [...markdownContent.matchAll(headingRegex)];

for (const match of matches) {
  const label = match[1];
  // Create URL-friendly ID from heading text
  const id = label
    .toLowerCase()
    .replace(/[^a-z0-9ąćęłńóśźż\s-]/g, "")
    .replace(/\s+/g, "-")
    .replace(/ą/g, "a")
    .replace(/ć/g, "c")
    .replace(/ę/g, "e")
    .replace(/ł/g, "l")
    .replace(/ń/g, "n")
    .replace(/ó/g, "o")
    .replace(/ś/g, "s")
    .replace(/ź/g, "z")
    .replace(/ż/g, "z");

  navigationItems.push({ id, label });
}

let processedContent = markdownContent;
for (const item of navigationItems) {
  const headingPattern = new RegExp(
    `^##\\s+${item.label.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}$`,
    "m",
  );
  processedContent = processedContent.replace(
    headingPattern,
    `<h2 id="${item.id}">$&</h2>`.replace("$&", item.label),
  );
}
---

<section class="fluid py-[64px] tbt:py-[96px] dsp:py-[120px]">
  <div class="dsp:grid dsp:grid-cols-[245px_1fr] dsp:gap-[20px]">
    <CourseNavigation items={navigationItems} client:load />

    <!-- Main Content -->
    <div class="w-full">
      <MarkdownRenderer 
        content={processedContent} 
        timeline={frontmatter.timeline} 
        gallery={frontmatter.gallery}
        client:load 
      />
    </div>
  </div>
</section>

