---
import { promises as fs } from "node:fs";
import path from "node:path";
import { loadCourseBySlug } from "@/lib/course-loader";
import MainLayout from "@/layouts/main.astro";
import { routing } from "@/core/config";
import LayoutNavigation from "@/components/layout/layout-navigation.astro";
import Breadcrumbs from "@/components/layout/breadcrumbs.astro";
import CourseCtaSection from "@/features/course/course-cta-section.astro";
import CourseHeroSection from "@/features/course/course-hero-section.astro";
import CourseSection from "@/features/course/course-section.astro";
import CourseWhySection from "@/features/course/course-why-section.astro";

export async function getStaticPaths() {
  const courseDir = path.join(process.cwd(), "public", "course");

  try {
    const items = await fs.readdir(courseDir, { withFileTypes: true });

    const courseFolders = items
      .filter((item) => item.isDirectory())
      .map((item) => item.name);

    const paths = await Promise.all(
      courseFolders.map(async (slug) => {
        const courseData = await loadCourseBySlug(slug);

        if (!courseData) {
          console.warn(
            `Skipping course "${slug}": missing content.md or data files`,
          );
          return null;
        }

        return {
          params: { slug },
          props: {
            frontmatter: courseData.frontmatter,
            content: courseData.content,
          },
        };
      }),
    );

    return paths.filter(Boolean);
  } catch (error) {
    console.error("Error loading courses:", error);
    return [];
  }
}

const { frontmatter, content } = Astro.props;
const { slug } = Astro.params;

const breadcrumbItems = [
  { label: "Home", href: routing.home },
  { label: "Mentoring", href: "#" },
];

// biome-ignore lint/style/noNonNullAssertion: <explanation>
const domain = Astro.site!.toString().replace(/\/$/, "");
const imageUrl = `${domain}/adrian-512.webp`;
---

<MainLayout
siteName="Kursy IT - Konsultacje i Rozwój Kariery | Adrian Połubiński"
url={routing.course(slug) as `/${string}/`}
twitterCreator="@polubis"
imageAlt="Adrian Połubiński"
twitterSite="@polubis"
domain={domain}
imageUrl={imageUrl}
keywords="zostań juniorem, zostań midem, zostań seniorem, jak zostać seniorem, jak zostać midem, jak zostać juniorem, course IT, awans na seniora, rozwój kariery IT, programowanie, konsultacje IT, wywiad techniczny, przygotowanie do rozmowy, Adrian Połubiński, nauka programowania, roadmapa rozwoju, Frontend, Backend, Fullstack, DevOps, AI, Soft Skills, Bazy danych, Algorytmy i struktury danych, greenonsoftware, 4markdown, IT Mentor Polska"
title="Kursy IT - Konsultacje i Rozwój Kariery | Adrian Połubiński"
description="Kursy IT – rozwijaj karierę programisty, przygotuj się do rozmów rekrutacyjnych i ucz się świadomie => uzyskaj awans"
>
<LayoutNavigation />
<div class="fluid pt-[32px]">
  <Breadcrumbs items={breadcrumbItems} />
</div>
<main>
<CourseHeroSection />
<CourseWhySection />
<CourseSection markdownContent={content} frontmatter={frontmatter} />
<CourseCtaSection />
</main>

  </MainLayout>